# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# LiveKit Cloud (https://cloud.livekit.io) — required for inference
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# OpenAI — used for STT, planner, TTS, and by the official gpt-4o evaluation judge
OPENAI_API_KEY=your_openai_api_key

# Optional overrides (defaults shown)
# FDAGENT_REASONER_MODEL=gpt-4o
# FDAGENT_STT_MODEL=whisper-1
# FDAGENT_TTS_MODEL=tts-1
# FDAGENT_TTS_VOICE=nova
# FDAGENT_SEED=7
# FDAGENT_STABILITY_S=0.6
# FDAGENT_BACKCHANNEL=1
# FDB_LATENCY_PROFILE=instant
# FDAGENT_JOURNAL_DIR=results/journals
# FDB_TOOL_LOG=/tmp/agent_tool_calls.log
# FDB_HEARTBEAT_LOG=/tmp/agent_heartbeat.log
