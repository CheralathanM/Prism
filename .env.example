# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# LiveKit Cloud (https://cloud.livekit.io, free Build plan) — required for inference
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Provider stack: gemini_local (default, zero-cost) | openai
# FDAGENT_STACK=gemini_local

# gemini_local: Google AI Studio key (free tier, no billing account). Used for the Gemini
# planner (and Gemini TTS only if FDAGENT_TTS_BACKEND=gemini). STT (Whisper) and default TTS (Piper) are local.
GOOGLE_API_KEY=your_google_ai_studio_api_key
# FDAGENT_GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite   # or gemini-3.8-flash
# FDAGENT_GEMINI_REASONING_EFFORT=low
# TTS backend: piper (default; local, offline, no quota) | gemini (optional; free-tier quota)
# FDAGENT_TTS_BACKEND=piper
# FDAGENT_PIPER_VOICE=~/.cache/fdagent/piper/en/en_US/lessac/medium/en_US-lessac-medium.onnx
# FDAGENT_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# FDAGENT_GEMINI_VOICE=Kore
# FDAGENT_WHISPER_MODEL=openai/whisper-base.en   # or whisper-tiny.en (faster) / whisper-small.en
# FDAGENT_TORCH_THREADS=4          # per-process PyTorch thread cap (keeps VAD real-time)
# FDAGENT_PREWARM_MAX_WAIT_S=600   # replacement workers defer model loading while a job is active
# FDAGENT_IDLE_PROCESSES=2

# openai stack only (optional). Also used by the official gpt-4o judge (--use-llm).
# OPENAI_API_KEY=your_openai_api_key
# FDAGENT_REASONER_MODEL=gpt-4o
# FDAGENT_STT_MODEL=whisper-1
# FDAGENT_TTS_MODEL=tts-1
# FDAGENT_TTS_VOICE=nova

# Shared (defaults shown)
# FDAGENT_SEED=7
# FDAGENT_STABILITY_S=0.6
# FDAGENT_BACKCHANNEL=1
# FDB_LATENCY_PROFILE=instant
# FDAGENT_JOURNAL_DIR=results/journals
# FDB_TOOL_LOG=/tmp/agent_tool_calls.log
# FDB_HEARTBEAT_LOG=/tmp/agent_heartbeat.log
